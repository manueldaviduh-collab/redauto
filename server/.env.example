# Copia este archivo a .env y completa los valores reales.
# Nunca subas .env al repositorio (ya está en .gitignore).

# Cadena de conexión a Postgres. En local (Postgres corriendo en esta
# misma máquina): postgresql://usuario:password@localhost:5432/redauto
# En producción (Supabase/Railway/etc.), la cadena que te dé el proveedor.
DATABASE_URL=postgresql://redauto:CAMBIA_ESTA_CLAVE@localhost:5432/redauto

# Pon "true" sólo si tu proveedor de Postgres exige SSL (la mayoría de los
# hosteados en la nube sí; un Postgres local normalmente no).
DATABASE_SSL=false

# Secreto para firmar las sesiones (JWT). Generar uno propio y único, por
# ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_VALOR_POR_UNO_PROPIO_Y_SECRETO

# Puerto donde corre esta API.
PORT=4000

# Origen permitido para CORS — la URL donde sirves el frontend. "*" es
# cómodo para desarrollo local; en producción conviene poner el dominio
# real del frontend.
CORS_ORIGIN=*

# Cloudinary (subida real de fotos de producto). Se obtienen del Dashboard
# de tu cuenta en cloudinary.com, botón "Go to API Keys". Si se dejan vacíos,
# la API sigue funcionando normalmente — sólo los endpoints de fotos
# responden 503 ("almacenamiento de imágenes no configurado").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
